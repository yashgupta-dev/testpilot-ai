{
    "name": "testpilot/laravel",
    "description": "Laravel adapter and dashboard for TestPilot AI: annotation-driven, AI-planned, human-approved Pest tests.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "testing",
        "pest",
        "ai",
        "test-generation",
        "dashboard"
    ],
    "require": {
        "php": "^8.2",
        "testpilot/core": "^0.8",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "TestPilot\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestPilot\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TestPilot\\Laravel\\TestPilotServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}