{
    "name": "testpilot/core",
    "description": "Framework-agnostic engine for TestPilot AI: attribute discovery, configuration resolution, AI test planning/generation and Pest execution.",
    "type": "library",
    "license": "MIT",
    "keywords": ["testing", "pest", "ai", "test-generation", "mutation-testing", "php"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "nikic/php-parser": "^5.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": { "TestPilot\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TestPilot\\Tests\\": "tests/" }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": { "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true } }
}
